{
  "match": "zap|owasp",
  "report_name": "OWASP ZAP Report",
  "finding": "div.alerts > div, div.alert, li.alert, .alert-details",
  "fields": {
    "title": {"selector": "h3, h4, .alert-name, .name"},
    "severity": {"selector": ".risk, .severity, .alert-risk"},
    "desc": {"selector": ".description, .alert-description, p"},
    "poc": {"selector": "pre, .evidence, .attack, .request, .response"},
    "remediation": {"selector": ".solution, .remediation, .fix"},
    "cve": {"selector": ".cve"},
    "cwe": {"selector": ".cwe"},
    "asset": {"selector": ".url, .uri, .host"}
  }
}
